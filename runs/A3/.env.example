# Copy to .env and adjust. All settings are prefixed EXITWF_.

EXITWF_ENVIRONMENT=local
EXITWF_DEBUG=true

# --- Database (PostgreSQL; payments + audit per SRS §15) -------------------
EXITWF_DATABASE_URL=postgresql+asyncpg://localhost:5432/exit_workflow
EXITWF_DB_POOL_SIZE=10
EXITWF_DB_MAX_OVERFLOW=20
EXITWF_DB_STATEMENT_TIMEOUT_MS=5000

# --- Auth -----------------------------------------------------------------
# MUST be overridden outside local/test. Startup fails if left at the default
# when EXITWF_ENVIRONMENT is staging/production.
EXITWF_JWT_SECRET=change-me-in-every-non-local-environment
EXITWF_JWT_ISSUER=meridian-identity
EXITWF_JWT_AUDIENCE=meridian-api

# --- Business policy (see README "Assumptions") ---------------------------
EXITWF_CURRENCY=AED
EXITWF_MIN_NOTICE_DAYS=0
EXITWF_MAX_MOVE_OUT_HORIZON_DAYS=365
EXITWF_ALLOW_DEDUCTION_ABOVE_DEPOSIT=true
EXITWF_INSPECTION_SLOT_MIN_LEAD_HOURS=12

# --- Document storage -----------------------------------------------------
EXITWF_STORAGE_ROOT=./var/storage
EXITWF_MAX_UPLOAD_BYTES=20971520

# --- Eventing (Kafka per SRS §7; outbox relay is always on) ---------------
EXITWF_KAFKA_ENABLED=false
EXITWF_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
EXITWF_KAFKA_TOPIC_PREFIX=meridian.exit
EXITWF_BACKGROUND_WORKER_ENABLED=true
EXITWF_OUTBOX_POLL_INTERVAL_SECONDS=1.0

# --- Compliance -----------------------------------------------------------
EXITWF_AUDIT_RETENTION_YEARS=7
