# --- Core ---------------------------------------------------------------------------------
ENVIRONMENT=local              # local | test | staging | production
DEBUG=false
API_PREFIX=/api/v1

# --- Database -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/exit_workflow
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=5000

# --- Security -----------------------------------------------------------------------------
# HS256 secret for verifying access tokens minted by the platform identity service.
# The app refuses to boot in production while this is left at the default.
JWT_SECRET=change-me-in-production
# JWT_ISSUER=meridian-identity
# JWT_AUDIENCE=exit-workflow

# --- Messaging ----------------------------------------------------------------------------
KAFKA_ENABLED=false            # true additionally requires the optional 'aiokafka' package
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=meridian.exit

# --- Notifications and the outbox relay -----------------------------------------------------
NOTIFICATIONS_ENABLED=true
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100

# --- Domain rules ---------------------------------------------------------------------------
# Notice period between the exit request and the requested move-out date. The SRS does not
# fix a value, so it is configurable per market.
MIN_NOTICE_DAYS=0
MAX_NOTICE_DAYS=365
# Comma-separated. Must all be present before a request can be submitted to the owner.
REQUIRED_DOCUMENT_KINDS=EMIRATES_ID
AUDIT_RETENTION_YEARS=7
CURRENCY=AED
MARKET_TIMEZONE=Asia/Dubai
